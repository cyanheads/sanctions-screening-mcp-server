# ── Transport ──────────────────────────────────────────────────────────
# MCP_TRANSPORT_TYPE=stdio          # stdio | http (default: stdio)
# MCP_HTTP_PORT=3010                # HTTP port (default: 3010)
# MCP_HTTP_HOST=127.0.0.1           # HTTP host (default: 127.0.0.1)
# MCP_HTTP_ENDPOINT_PATH=/mcp      # HTTP endpoint path (default: /mcp)
# MCP_HTTP_MAX_BODY_BYTES=1048576  # Max request body bytes; 413 over limit, 0 disables (default: 1048576)
# MCP_PUBLIC_URL=                  # Public origin behind a TLS-terminating proxy (e.g. https://mcp.example.com)

# ── Auth ──────────────────────────────────────────────────────────────
# MCP_AUTH_MODE=none                # none | jwt | oauth (default: none)
# MCP_AUTH_SECRET_KEY=              # JWT secret (required for jwt mode)

# ── Storage ───────────────────────────────────────────────────────────
# STORAGE_PROVIDER_TYPE=in-memory   # in-memory | filesystem | supabase | cloudflare-r2 | cloudflare-kv | cloudflare-d1

# ── Session ──────────────────────────────────────────────────────────
MCP_SESSION_MODE=stateless          # stateful | stateless | auto. Set here, not left to the schema default
                                    # (auto, which resolves to stateful). Every read is answered from the
                                    # local mirror and no tool calls ctx.requestInput, so nothing needs a
                                    # session to come back to. src/index.ts declares the same value.

# ── Memory ───────────────────────────────────────────────────────────
# MCP_GC_PRESSURE_INTERVAL_MS=0     # Opt-in forced Bun.gc(true) interval, ms (Bun only). Drains old-gen backlog
                                    # under sustained HTTP load (issue #50). Try 60000 if RSS grows. Default: 0.

# ── Logging ───────────────────────────────────────────────────────────
# MCP_LOG_LEVEL=info                # debug | info | notice | warning | error
# MCP_LOG_RATE_LIMIT_THRESHOLD=10   # Max emissions per level+message per window; 0 disables
# MCP_LOG_RATE_LIMIT_WINDOW_MS=60000

# ── Telemetry ─────────────────────────────────────────────────────────
# OTEL_ENABLED=false                          # Enable OpenTelemetry (default: false)
# OTEL_EXPORTER_OTLP_ENDPOINT=               # OTLP base URL (e.g., http://localhost:4318); traces → /v1/traces, metrics → /v1/metrics
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=        # Overrides the base for traces; used as-is
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=       # Overrides the base for metrics; used as-is

# ── Server-specific ──────────────────────────────────────────────────
# All sources are keyless — no API key is required. Every variable below is
# optional with a default; uncomment only to override.

# Local SQLite mirror path (a persistent volume on a hosted deployment).
# SANCTIONS_MIRROR_PATH=./data/sanctions.db

# Cron for the scheduled mirror refresh (HTTP only). Each run re-harvests the
# sanctions lists and rebuilds the name and identifier indexes, then applies the
# GLEIF delta windows its checkpoint calls for, under one 4-hour time bound. A GLEIF
# gap that needs mirror:init is logged, never loaded in-process.
# SANCTIONS_REFRESH_CRON=0 4 * * *

# Default Jaro-Winkler similarity floor for fuzzy matches when minScore is omitted.
# SANCTIONS_FUZZY_MIN_SCORE=0.85

# Hard cap on fuzzy candidates scored per query (bounds work on short queries).
# SANCTIONS_FUZZY_MAX_RESULTS=50

# Skip the GLEIF leg of mirror:init (loads only the small sanctions lists).
# SANCTIONS_INIT_SKIP_GLEIF=1

# Skip the GLEIF leg of mirror:refresh and of the scheduled refresh (refreshes
# only the sanctions lists).
# SANCTIONS_REFRESH_SKIP_GLEIF=1

# Source URL overrides — default to the verified official endpoints. The EU
# "token" is a static public path component, not a credential.
# OFAC_SDN_URL=https://sanctionslistservice.ofac.treas.gov/api/PublicationPreview/exports/SDN_ADVANCED.XML
# OFAC_CONSOLIDATED_URL=https://sanctionslistservice.ofac.treas.gov/api/PublicationPreview/exports/CONS_ADVANCED.XML
# EU_FSF_URL=https://webgate.ec.europa.eu/fsd/fsf/public/files/xmlFullSanctionsList_1_1/content?token=dG9rZW4tMjAxNw
# UK_SANCTIONS_URL=https://sanctionslist.fcdo.gov.uk/docs/UK-Sanctions-List.xml
# UN_SC_URL=https://scsanctions.un.org/resources/xml/en/consolidated.xml
# GLEIF_GOLDEN_COPY_BASE_URL=https://goldencopy.gleif.org
