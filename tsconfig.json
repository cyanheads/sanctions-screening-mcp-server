{
  "extends": "@cyanheads/mcp-ts-core/tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "noEmit": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "tests/**/*", "scripts/_mirror-context.ts", "scripts/mirror-*.ts"],
  "exclude": ["node_modules", "dist"]
}
